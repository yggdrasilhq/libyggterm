  {"kind":"sparkline","spec":{"label":"Battery","values":[80.0,null,72.0,71.0,null,68.0],"value":"68%","delta":"-12 over the window","evidence":{"question":"is the synthetic battery series monotonic under gaps?","source":"t3corpus synthetic","window":"the 6 planted values","freshness":"static","units":"percent","state":"observed","reproduction":"emd-page selftest design/notebooks/t3miniapp-sections.emd"}}}
]}}
